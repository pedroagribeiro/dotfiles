{
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "never"
  },
  "cursor_shape": "block",
  "cursor_blink": true,
  "autosave": "on_focus_change",
  "buffer_font_fallbacks": [
    "JetBrainsMono NF",
    "JetBrainsMono Nerd Font Mono",
    "JetBrainsMono NFM"
  ],
  "show_whitespaces": "trailing",
  "show_edit_predictions": true,
  "wrap_guides": [
    120
  ],
  "preferred_line_length": 120,
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  // Static, deliberately. omamac drives Zed's COLOURS via
  // ~/.config/zed/themes/omamac.json, but not its font: Zed has no include
  // mechanism, so the only place to write one is this file — which is
  // git-tracked, and generated values do not belong in git. Kept in step
  // with the terminal by hand.
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "vim_mode": true,
  "project_panel": {
    "default_width": 240,
    "dock": "right",
    "entry_spacing": "comfortable",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
  },
  "ui_font_size": 14,
  "buffer_font_size": 15,
  "buffer_font_features": {
    "calt": false,
  },
  "terminal": {
    "font_fallbacks": [
      "JetBrainsMono NF",
      "JetBrainsMono Nerd Font Mono",
      "JetBrainsMono NFM"
    ],
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 14.0,
  },
  "languages": {
    "C": { "show_whitespaces": "trailing",
           "show_edit_predictions": true,
           "wrap_guides": [
              120
           ],
           "preferred_line_length": 120,
           "format_on_save": "on" },
  },
  // omamac generates ~/.config/zed/themes/omamac.json from the active theme
  // and Zed hot-reloads it. Its appearance already follows the theme, so
  // there is no light/dark pair to switch between. The VS Code themes stay
  // installed and selectable by hand.
  "theme": "omamac",
}
